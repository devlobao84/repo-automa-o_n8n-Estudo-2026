    {
      "parameters": {
        "jsCode": "const aprovados = [];\nconst reprovados = [];\n\nfor (const item of items) {\n    const dados = item.json;\n\n    const experiencia = parseInt(dados['Anos de Experiência']);\n    const escolaridade = dados['Grau de Escolaridade'];\n\n    const aprovado = (experiencia > 5 && escolaridade === \"Superior\");\n    \n    const linhaTexto = \n        `Nome: ${dados.Nome} | ` +\n        `E-mail: ${dados['E-mail']} | ` +\n        `Experiência: ${dados['Anos de Experiência']} anos | ` +\n        `Escolaridade: ${dados['Grau de Escolaridade']}`;\n        \n    if (aprovado) {\n        aprovados.push(linhaTexto);\n    } else {\n        reprovados.push(linhaTexto);\n    }\n}\n\nconst aprovadosString = aprovados.join('\\n');\nconst reprovadosString = reprovados.join('\\n');\n\nreturn [\n    {\n        json: {\n            candidatos_aprovados: aprovadosString,\n            candidatos_reprovados: reprovadosString,\n        },\n    },\n];"
      },
